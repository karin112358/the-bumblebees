# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# generated YouTube assets: unpacked font cache, rendered covers and videos
tools/youtube/.fonts/
tools/youtube/**/out/

# Source recordings for the video build. Kept out of the repo deliberately:
# they run to tens of megabytes per gig, and they are recordings of songs we
# do not hold the rights to — this repository is public. The CSVs and the
# build scripts stay tracked, so a gig folder only needs its audio dropped back
# in to rebuild.
tools/youtube/**/*.mp3

# The whole-concert recording that split-video.mjs cuts up — same rights
# reasoning as the MP3s above, and it runs to gigabytes per gig.
tools/youtube/**/full-video.mp4

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
