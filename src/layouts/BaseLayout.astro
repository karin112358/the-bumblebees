---
import { getImage } from 'astro:assets';

import '../styles/global.css';
import heroPhoto from '../assets/images/band-1.jpg';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'The Bumblebees',
  description =
    'The Bumblebees — sieben Hobbymusiker aus Oberösterreich. Rock, Bläser und eine Setlist, bei der der Spaß im Vordergrund steht. Kommende Konzerte und Booking.',
} = Astro.props;

const pageTitle = title === 'The Bumblebees' ? 'The Bumblebees — Live-Musik · Rock' : `${title} — The Bumblebees`;

/*
 * og:image has to be an absolute URL, and the optimised asset only gets its
 * hashed path at build time — so resolve it through getImage() rather than
 * hardcoding anything under public/.
 */
const ogImage = await getImage({ src: heroPhoto, width: 1200, height: 630, format: 'jpeg' });
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Files in public/ are not rewritten for `base`, so this has to be built
      from BASE_URL by hand. BASE_URL may or may not carry a trailing slash
      depending on how `base` is written, so strip it and add one back —
      otherwise the two concatenate into "/the-bumblebeesfavicon.svg".
    */}
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`}
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#131312" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Bumblebees" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <!--
      The design is a fixed 1180px column of #131312 floating on the darker page
      black, so the shell — not each section — owns the width and the panel colour.
    -->
    <div class="shell">
      <slot />
    </div>

    <style is:global>
      html {
        scroll-behavior: smooth;
        /* Keep anchor targets clear of the sticky nav that overlays them. */
        scroll-padding-top: var(--bb-nav-h);
      }

      /*
       * The shell spans the viewport and owns only the panel colour. Width is
       * capped per component (.nav-inner, .bb-section, .booking .inner, the
       * footer's .inner), which lets the hero, marquee and booking bands run
       * edge to edge without any 100vw breakout — and so without the horizontal
       * overflow that 100vw causes once a scrollbar is present.
       *
       * No overflow clip here either: it would trap the sticky nav, since
       * sticky resolves against the nearest clipping ancestor rather than the
       * viewport. The three bands that bleed each clip themselves instead.
       */
      .shell {
        position: relative;
        background: var(--bb-panel);
      }
    </style>
  </body>
</html>
