---
import { Image } from 'astro:assets';

import Wordmark from '../assets/logo/wordmark.svg';
import band1Jpeg from '../assets/images/band-1.jpeg';
import band1Jpg from '../assets/images/band-1.jpg';
import band2 from '../assets/images/band-2.jpg';

/*
 * Slide 1 stays band-1.jpeg — the LCP image whose framing (object-position)
 * and scrim were tuned; the others rotate in behind it. objectPosition is
 * per-slide because each photo crops differently under object-fit: cover.
 * Panoramic shots (e.g. band-5.jpeg, 2016x1134) crop badly on portrait
 * phones — stick to 4:3 sources here.
 */
const slides = [
  { src: band1Jpeg, objectPosition: 'center 0%' },
  { src: band1Jpg },
  { src: band2 },
];
---

<section class="hero" id="top">
  <!--
    The slides are stacked and cross-faded in pure CSS (see keyframes below).
    Slide 1 must stay the LCP element: eager + high priority, real alt text.
    The later slides are decorative repeats of the same subject, so they get
    alt="" and load eagerly at low priority — lazy loading is avoided because
    whether browsers fetch a covered, opacity-0 in-viewport image is
    heuristic-dependent; eager+low guarantees they are decoded well before
    the first fade without competing with the LCP fetch.
  -->
  <div class="photos">
    {
      slides.map(({ src, objectPosition }, i) => (
        <Image
          class="photo"
          src={src}
          alt={i === 0 ? 'Die Bumblebees live auf der Bühne' : ''}
          widths={[640, 960, 1280, 1693]}
          sizes="100vw"
          loading="eager"
          fetchpriority={i === 0 ? 'high' : 'low'}
          style={objectPosition ? `--pos: ${objectPosition}` : undefined}
        />
      ))
    }
  </div>
  <div class="glow" aria-hidden="true"></div>
  <div class="scrim" aria-hidden="true"></div>

  <div class="content">
    <p class="kicker">Rockklassiker, starke Stimme und Saxophon-Power</p>
    <h1 class="wordmark">
      <Wordmark role="img" aria-label="The Bumblebees" />
    </h1>
    <div class="actions">
      <a class="bb-btn bb-btn-solid" href="#konzerte">Kommende Konzerte →</a>
      <a class="bb-btn btn-ghost" href="#buchen">Buchen</a>
    </div>
  </div>

  <span class="rotated" aria-hidden="true">Live-Musik</span>
</section>

<style>
  .hero {
    position: relative;
    /*
     * svh, not vh or dvh: vh would hide the bottom of the hero under mobile
     * browser chrome, and dvh would resize the whole section as that chrome
     * hides on scroll.
     */
    height: 100svh;
    /* Floor for short landscape phones, where 100svh gets very shallow. */
    min-height: 520px;
    /*
     * Pull the hero up under the sticky nav so the photo starts at y=0 and
     * fills exactly one viewport. Without this the nav's 80px band would push
     * the hero down and the last 80px would sit below the fold.
     */
    margin-block-start: calc(-1 * var(--bb-nav-h));
    overflow: hidden;
  }

  /*
   * The slides carry z-indexes so the outgoing image always sits above the
   * incoming one. isolation: isolate contains those z-indexes inside this
   * wrapper, so the wrapper as a whole still paints below .glow/.scrim/
   * .content/.rotated exactly like a single photo would.
   */
  .photos {
    position: absolute;
    inset: 0;
    isolation: isolate;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Per-slide framing; the default sits slightly above centre so the band
       lands under the wordmark (tuned for band-1.jpeg). */
    object-position: var(--pos, center 0%);
  }

  /*
   * Cross-fade rotator, pure CSS. One shared 24s clock with no delays, so
   * the slides can never drift apart. The trick: during every transition
   * exactly one slide animates while a fully opaque slide sits directly
   * beneath it — so there is never a dark dip or a double exposure,
   * including on the very first cycle and at the wrap-around.
   *
   * Timeline (18s = 3 slides x 6s, 1.5s fades; 6s = 33.333%, 1.5s = 8.333%):
   *   slide 1 (top):    visible 0-6s, fades OUT 6-7.5s, fades back IN 16.5-18s
   *   slide 2:          opaque under cover, fades OUT 12-13.5s
   *   slide 3 (bottom): permanently opaque base layer, no animation
   * Slide 2 snaps back to opacity 1 at the loop point, invisibly, because
   * slide 1 is fully opaque above it at that instant. Slide 1's 0%
   * keyframe matches its natural opacity of 1, so the page loads with the
   * hero already painted — no fade-in flash, no LCP change.
   *
   * Adding or removing a slide means recomputing these percentages by hand
   * (keyframe selectors cannot use custom properties).
   */
  .photo:nth-child(1) {
    z-index: 3;
    animation: hero-slide-1 18s ease-in-out infinite;
  }

  .photo:nth-child(2) {
    z-index: 2;
    animation: hero-slide-2 18s ease-in-out infinite;
  }

  .photo:nth-child(3) {
    z-index: 1;
  }

  @keyframes hero-slide-1 {
    0%,
    33.333% {
      opacity: 1;
    }

    41.667%,
    91.667% {
      opacity: 0;
    }

    100% {
      opacity: 1;
    }
  }

  @keyframes hero-slide-2 {
    0%,
    66.667% {
      opacity: 1;
    }

    75%,
    100% {
      opacity: 0;
    }
  }

  /*
   * The global reduced-motion rule collapses animation duration, which would
   * complete all fades instantly and hard-cut between slides. Kill the
   * animations outright instead: every slide reverts to its natural opacity
   * of 1, and slide 1 — the top of the stack — shows as a static hero image.
   */
  @media (prefers-reduced-motion: reduce) {
    .photo {
      animation: none;
    }
  }

  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 30% 40%,
        rgba(244, 178, 35, 0.28),
        transparent 55%
      ),
      radial-gradient(
        circle at 78% 70%,
        rgba(78, 120, 220, 0.3),
        transparent 55%
      );
    mix-blend-mode: screen;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background:
      /*
       * The nav now sits over the photo rather than on the panel, so the top of
       * the frame needs its own darkening for the white and amber nav text to
       * stay legible against a bright stage shot.
       */
      linear-gradient(180deg, rgba(11, 11, 13, 0.7), transparent 22%),
      /*
       * Extra darkening over the bottom third, where the audience's heads sit —
       * sinks that busy silhouette so it doesn't compete with the wordmark and
       * buttons that overlay the same area.
       */
      linear-gradient(0deg, rgba(11, 11, 13, 0.96), transparent 70%),
      linear-gradient(180deg, rgba(11, 11, 13, 0.35), rgba(11, 11, 13, 0.85));
  }

  .content {
    position: absolute;
    z-index: 10;
    left: var(--bb-gutter);
    right: var(--bb-gutter);
    bottom: clamp(32px, 6vw, 60px);
  }

  .kicker {
    font-family: var(--bb-condensed);
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-weight: 600;
    font-size: clamp(12px, 2vw, 15px);
    color: var(--bb-amber);
    margin-block-end: 6px;
  }

  .wordmark {
    /* The <h1> is only a semantic wrapper; the SVG carries the accessible name. */
    line-height: 0;
  }

  .wordmark :global(svg) {
    width: min(660px, 92%);
    height: auto;
    filter: drop-shadow(0 10px 34px rgba(0, 0, 0, 0.55));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-block-start: clamp(20px, 3vw, 30px);
  }

  /*
   * The hero's measurements are the .bb-btn base, so the solid button needs
   * nothing here. Only the ghost variant is local — it exists nowhere else.
   */
  .btn-ghost {
    border: 1.5px solid var(--bb-dimmer);
    color: var(--bb-white);
  }

  .btn-ghost:hover {
    border-color: var(--bb-white);
    color: var(--bb-white);
  }

  .rotated {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-family: var(--bb-display);
    letter-spacing: 0.24em;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
  }

  /* Decorative, and it collides with the buttons once the hero narrows. */
  @media (max-width: 900px) {
    .rotated {
      display: none;
    }

    .actions .bb-btn {
      flex: 1 1 auto;
      text-align: center;
    }
  }
</style>
