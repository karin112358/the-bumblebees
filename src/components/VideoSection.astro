---
import { Image } from 'astro:assets';

import coverImage from '../assets/images/video-cover/2026-07-11-sierning-cover.jpg';
import beeUrl from '../assets/logo/bee.svg?url';
import wordmarkUrl from '../assets/logo/wordmark.svg?url';

/*
 * The clip lives on YouTube (privacy-enhanced -nocookie host) and is embedded
 * only after an explicit consent step. autoplay=1 starts it once the iframe is
 * swapped in for the poster.
 *
 * Why two steps rather than loading on the first click: consent under Art. 4
 * no. 11 GDPR has to be *informed*, and a bare play glyph is not. Someone
 * pressing it is saying "I want to watch", not "I agree to my IP address going
 * to Google in the US". So the first click only opens the notice — which names
 * the recipient, the data and the transfer — and nothing is requested from
 * YouTube until the button in that notice is pressed.
 */
const embedSrc =
  'https://www.youtube-nocookie.com/embed/33XQZg2YYDY?autoplay=1&rel=0';

const duration = '2:46';

/*
 * Same BASE_URL dance as SiteFooter: Astro rewrites neither, and BASE_URL may
 * or may not carry a trailing slash depending on how `base` is written.
 */
const datenschutzHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/datenschutz/`;
---

<section class="bb-section" id="video">
  <div class="bb-section-head">
    <h2>Ansehen</h2>
    <p class="bb-eyebrow">Video</p>
  </div>

  {/*
    A facade rather than an always-on iframe: nothing is loaded from YouTube
    until consent is given. The poster only opens the notice below it — the
    embed URL sits on the confirm button, so the poster itself cannot trigger a
    request even if the script were changed carelessly.
  */}
  <div class="stage" data-video-stage>
    <button
      class="poster"
      type="button"
      aria-haspopup="dialog"
      aria-label="Live-Video abspielen — fragt zuerst nach Ihrer Einwilligung"
    >
      <Image
        class="cover"
        src={coverImage}
        alt="Die Bumblebees live in Sierning"
        widths={[480, 640, 960]}
        sizes="(max-width: 860px) 92vw, 1180px"
        loading="lazy"
      />
      <span class="wash" aria-hidden="true"></span>

      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
          <path d="M8 5v14l11-7z" fill="currentColor" />
        </svg>
      </span>

      <span class="meta" aria-hidden="true">
        <img class="bee" src={beeUrl} alt="" width="34" height="34" />
        <img class="wordmark" src={wordmarkUrl} alt="" width="150" height="38" />
        <span class="live">Live · 2026</span>
      </span>

      <span class="duration" aria-hidden="true">{duration}</span>
    </button>

    {/*
      The consent notice. Everything a visitor needs in order to decide is here,
      visible *before* the button that actually loads anything: who receives the
      data, what is sent, that it goes to the US, and that YouTube may then store
      things on the device. The choice is not remembered — see /datenschutz/.
    */}
    <div
      class="consent"
      data-video-consent
      hidden
      role="dialog"
      aria-labelledby="video-consent-title"
      aria-describedby="video-consent-text"
    >
      <div class="consent-inner">
        <h3 id="video-consent-title">Video von YouTube laden?</h3>
        <p id="video-consent-text">
          Dabei werden Ihre IP-Adresse und Angaben zu Ihrem Gerät an die Google
          Ireland Limited übertragen; die Verarbeitung kann auch in den USA
          erfolgen. YouTube kann anschließend Informationen auf Ihrem Gerät
          speichern. Bis Sie zustimmen, wird nichts geladen.
        </p>
        <p class="consent-link">
          <a href={datenschutzHref}>Mehr in der Datenschutzerklärung</a>
        </p>
        <div class="consent-actions">
          <button class="btn solid" type="button" data-video-accept data-embed-src={embedSrc}>
            Einverstanden, Video laden
          </button>
          <button class="btn outline" type="button" data-video-cancel>Abbrechen</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /*
   * Poster -> notice -> iframe. The only place that touches the YouTube URL is
   * the accept handler, so no request can leave before consent.
   */
  for (const stage of document.querySelectorAll<HTMLElement>('[data-video-stage]')) {
    const poster = stage.querySelector<HTMLButtonElement>('.poster');
    const consent = stage.querySelector<HTMLElement>('[data-video-consent]');
    const accept = stage.querySelector<HTMLButtonElement>('[data-video-accept]');
    const cancel = stage.querySelector<HTMLButtonElement>('[data-video-cancel]');
    if (!poster || !consent || !accept || !cancel) continue;

    const closeNotice = () => {
      consent.hidden = true;
      stage.classList.remove('is-asking');
      poster.disabled = false;
      poster.focus();
    };

    poster.addEventListener('click', () => {
      consent.hidden = false;
      /*
       * The poster stays visible as the backdrop, but disabling it takes it out
       * of the tab order so keyboard focus cannot land behind the notice.
       */
      poster.disabled = true;
      stage.classList.add('is-asking');
      accept.focus();
    });

    cancel.addEventListener('click', closeNotice);

    // Focus is inside the stage while the notice is open, so this reaches it.
    stage.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !consent.hidden) closeNotice();
    });

    accept.addEventListener(
      'click',
      () => {
        const src = accept.dataset.embedSrc;
        if (!src) return;

        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = 'The Bumblebees — Live-Video';
        iframe.className = 'clip';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;

        stage.classList.remove('is-asking');
        consent.remove();
        poster.replaceWith(iframe);
        // The button that had focus is gone; hand it to the player instead.
        iframe.focus();
      },
      { once: true },
    );
  }
</script>

<style>
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--bb-radius-lg);
    overflow: hidden;
    border: 1px solid var(--bb-border);
    background: var(--bb-panel);
  }

  /*
   * While the notice is open the box has to be allowed to outgrow 16:9. At
   * phone widths the ratio leaves under 200px of height — nowhere near enough
   * for the heading, the text and both buttons, and a notice you have to
   * scroll to finish reading is not an informed one.
   *
   * `min-block-size: fit-content` reads like the right tool but does not work:
   * a box that also carries `aspect-ratio` does not grow from it (re-verified
   * after the width fix below, so this is not a side effect of that). Hence an
   * explicit floor, staggered because how far the text wraps depends heavily on
   * width. Measured need per device width, without a scrollbar:
   *
   *   320px -> 430    360px -> 389    390px -> 366    430px -> 343
   *
   * The floor only bites below roughly 860px of viewport width — above that the
   * 16:9 height is the larger of the two and wins, so desktop is untouched. The
   * poster is absolutely positioned and simply fills the taller box.
   */
  .stage.is-asking {
    display: flex;
    /*
     * `inline-size: 100%` is load-bearing, not decoration. Without it the width
     * stays `auto`, and `aspect-ratio` then runs backwards: it takes the
     * min-block-size below and derives a *width* from it, so on a 390px phone
     * the stage came out 448 x 796 and pushed the whole page into horizontal
     * scrolling. Giving the width a definite value forces the ratio to work in
     * the intended direction — width first, height from it, then raised by the
     * minimum. Desktop is unaffected: 100% there is still the 16:9 height,
     * which is larger than the minimum anyway.
     */
    inline-size: 100%;
    min-block-size: 23rem;
  }

  @media (max-width: 400px) {
    .stage.is-asking {
      min-block-size: 26rem;
    }
  }

  @media (max-width: 340px) {
    .stage.is-asking {
      min-block-size: 28rem;
    }
  }

  /*
   * The poster stays as the backdrop, but its furniture does not. On a phone the
   * notice is taller than its text, and the play disc, the bee/wordmark corner
   * and the running time showed through the scrim underneath the buttons as
   * ghosted smudges — they read as leftovers rather than as part of the panel.
   * The photo alone behind the scrim is what the notice should sit on.
   */
  .stage.is-asking .play,
  .stage.is-asking .meta,
  .stage.is-asking .duration {
    opacity: 0;
  }

  /*
   * The hover state is driven through these custom properties, set on the
   * poster and read by .wash / .play via var(). Two reasons it is done this way:
   *
   *  - The obvious `.poster:hover .wash { ... }` gets miscompiled: the CSS
   *    minifier drops the redundant `.poster` ancestor (every .wash/.play lives
   *    inside a .poster) but discards the `:hover` with it, baking the hover
   *    look in permanently. Keeping `:hover` on the poster itself avoids that.
   *
   *  - They are registered with @property so they can be *transitioned*. An
   *    unregistered custom property changing on an ancestor updates the child's
   *    value instantly — the child's own `transition` never fires, so the change
   *    jumps. Animating the registered property on the poster interpolates it
   *    frame by frame, and the children reading it follow smoothly.
   */
  @property --wash-opacity {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
  @property --play-scale {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
  @property --play-bg {
    syntax: '<color>';
    inherits: true;
    initial-value: #f3c814;
  }

  /* The poster fills the stage and is the click target. */
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: block;

    --wash-opacity: 1;
    --play-scale: 1;
    --play-bg: var(--bb-amber);
    transition:
      --wash-opacity 0.7s ease-out,
      --play-scale 0.7s cubic-bezier(0.34, 1.56, 0.64, 1),
      --play-bg 0.7s ease-out;
  }

  .poster:hover,
  .poster:focus-visible {
    --wash-opacity: 0.6;
    --play-scale: 1.06;
    --play-bg: var(--bb-amber-bright, #ffd21f);
  }

  .cover,
  .poster :global(img.cover) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A soft darkening so the yellow button and the corner marks stay legible. */
  .wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.4)),
      linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent 45%);
    /* Lifts on hover to hint the poster is interactive — see .poster vars. */
    opacity: var(--wash-opacity);
  }

  .bee {
    width: clamp(44px, 5vw, 58px);
    height: auto;
    opacity: 0.9;
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(var(--play-scale));
    width: clamp(58px, 7vw, 74px);
    height: clamp(58px, 7vw, 74px);
    border-radius: 50%;
    background: var(--play-bg);
    color: var(--bb-panel);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Nudge the glyph right so it sits optically centred in the disc. */
  .play svg {
    margin-inline-start: 3px;
  }

  .poster:focus-visible {
    outline: 2px solid var(--bb-amber);
    outline-offset: -4px;
  }

  /* Disabled only while it acts as the backdrop, so drop the affordance. */
  .poster:disabled {
    cursor: default;
  }

  /*
   * `align-self: stretch` makes the scrim cover the whole stage even when the
   * 16:9 box is taller than the text, so the poster never half shows through.
   */
  .consent {
    position: relative;
    z-index: 2;
    align-self: stretch;
    inline-size: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 3vw, 34px);
    background: rgba(9, 9, 8, 0.9);
    /*
     * Belt and braces behind the min-block-size above: if the text ever grows
     * past the floor, the notice scrolls rather than clipping its buttons away.
     */
    overflow-y: auto;
  }

  /*
   * Beats the `display: flex` above on specificity, which a bare [hidden] rule
   * would not — without this the notice would be visible from the start.
   */
  .consent[hidden] {
    display: none;
  }

  .consent-inner {
    max-inline-size: 460px;
    text-align: center;
  }

  /* Global h3 is the Anton display face; the notice wants the reading one. */
  .consent h3 {
    font-family: var(--bb-condensed);
    font-size: clamp(20px, 3.5vw, 26px);
    letter-spacing: 0.04em;
    margin-block-end: 12px;
  }

  .consent p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--bb-text);
  }

  .consent-link {
    margin-block-start: 10px;
  }

  .consent-link a {
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .consent-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-block-start: 22px;
  }

  /*
   * Below this the two buttons no longer fit on one line — the confirm label is
   * twice the width of "Abbrechen", so wrapping leaves a wide button above a
   * narrow one. Side by side that difference reads as neutral; stacked it reads
   * as "reject is the lesser option", which is precisely the shape supervisory
   * authorities reject in consent dialogs. Stretching both to the full width
   * makes them identical again.
   */
  @media (max-width: 520px) {
    .consent-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /*
   * Mirrors the .btn rules in BookingCta.astro — Astro scopes <style> per
   * component, so they cannot be shared, only kept visually in step. Colours
   * are inverted here because this sits on a dark scrim rather than on amber.
   *
   * Both buttons are deliberately the same size and weight: supervisory
   * authorities treat a consent dialog whose reject option is quieter than its
   * accept option as invalid, and nothing is preselected.
   */
  .btn {
    font-family: var(--bb-condensed);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 15px;
    padding: 13px 22px;
    border: 2px solid var(--bb-amber);
    border-radius: var(--bb-radius-btn);
    cursor: pointer;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .solid {
    background: var(--bb-amber);
    color: var(--bb-panel);
  }

  .solid:hover {
    background: var(--bb-amber-hover);
    border-color: var(--bb-amber-hover);
  }

  .outline {
    background: none;
    color: var(--bb-amber);
  }

  .outline:hover {
    opacity: 0.75;
  }

  .meta {
    position: absolute;
    left: 20px;
    bottom: 18px;
    display: flex;
    flex-direction: column;
    /* Centre the bee over the wordmark (the widest item in the stack). */
    align-items: center;
    gap: 8px;
  }

  .wordmark {
    width: clamp(112px, 14vw, 150px);
    height: auto;
  }

  .live {
    font-family: var(--bb-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bb-amber);
  }

  .duration {
    position: absolute;
    right: 18px;
    bottom: 18px;
    font-family: var(--bb-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--bb-white);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .clip,
  .stage :global(iframe.clip) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
</style>
