---
import { Image } from 'astro:assets';

import { members } from '../data/members';
---

<section class="bb-section" id="band">
  <div class="bb-section-head">
    <h2>Die Band</h2>
    <p class="bb-eyebrow">Besetzung</p>
  </div>

  <ul class="grid">
    {
      members.map(({ name, role, photo }) => (
        <li>
          <div class="frame">
            {photo ? (
              <Image
                src={photo}
                alt={`${name}, ${role}`}
                widths={[280, 560]}
                sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 280px"
              />
            ) : (
              <span class="placeholder">◹ Foto</span>
            )}
          </div>
          <p class="role">{role}</p>
          <p class="name">{name}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .frame {
    aspect-ratio: 1 / 1;
    border-radius: var(--bb-radius);
    overflow: hidden;
    border: 1px solid var(--bb-border);
    margin-block-end: 12px;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * The stand-in for a member without a photo. This is the only slot left that
   * has none, so it lives here rather than in global.css — where it was a
   * "utility" with exactly one caller, and one that overrode three of its
   * properties at that. The frame supplies the border and the square.
   */
  .placeholder {
    width: 100%;
    height: 100%;
    background: var(--bb-stripes);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--bb-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bb-dim);
    text-align: center;
    padding: 12px;
  }

  .role {
    font-family: var(--bb-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--bb-amber);
    text-transform: uppercase;
  }

  .name {
    font-family: var(--bb-condensed);
    font-weight: 700;
    font-size: 17px;
    color: var(--bb-white);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.12;
    margin-block-start: 2px;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }
</style>
