---
const year = new Date().getFullYear();

/*
 * Same BASE_URL dance as the favicon in BaseLayout: Astro rewrites neither, and
 * BASE_URL may or may not carry a trailing slash depending on how `base` is
 * written — so strip it and add one back rather than concatenating blindly.
 */
const impressumHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/impressum/`;
---

<footer class="footer">
  <div class="inner">
    <span>© {year} The Bumblebees</span>
    <a href={impressumHref}>Impressum</a>
    <span>Live-Musik · Rock</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--bb-panel);
    padding-block: 26px;
  }

  .inner {
    max-inline-size: var(--bb-max);
    margin-inline: auto;
    padding-inline: var(--bb-gutter);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--bb-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: #55555c;
    text-transform: uppercase;
  }

  /* The footer keeps its own muted tone rather than the global amber links. */
  .inner a {
    color: inherit;
  }

  .inner a:hover {
    color: var(--bb-amber);
  }
</style>
