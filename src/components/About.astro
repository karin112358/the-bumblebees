---
import { Image } from 'astro:assets';

import { members } from '../data/members';

import portraitPhoto from '../assets/images/band-2.jpg';

/*
 * Derived from members.ts rather than typed out, for the same reason the member
 * count was: a hand-written list drifts. It had already picked up three errors —
 * it said "Klavier" where the grid says "Piano", hid the second saxophone, and
 * listed six instruments for seven people.
 *
 * Roles keep the order they appear in members.ts, and a role held by more than
 * one member is marked with its count.
 */
const lineup = [...new Set(members.map((m) => m.role))]
  .map((role) => {
    const held = members.filter((m) => m.role === role).length;
    return held > 1 ? `${role}` : role;
  })
  .join(', ');
---

<section class="about bb-section bb-split" id="ueber-uns">
  <div>
    <p class="bb-eyebrow">Über uns</p>
    <h2>Laut, eingespielt<br />und gemacht<br />für die Bühne.</h2>
    {
      /*
      TODO: "bekannte Rocksongs" is inferred from the marquee — narrow it to what
      you actually play if you can (z. B. "Rock und Austropop aus vier
      Jahrzehnten"). A booker scanning this wants to picture the evening.
    */
    }
    <p class="bb-prose body">
      Von „December, 1963“ über „Smooth Operator“ und „Virtual Insanity“ bis zu
      „Under Pressure“, „Hold the Line“ und „Sweet Child o’ Mine“: Unsere
      Setlist bewegt sich zwischen Rock, Funk, Soul und Pop.
    </p>
    <p class="bb-prose body">
      Wir spielen bekannte Songs, aber nicht nur die üblichen
      Coverband-Klassiker. Entscheidend ist für uns, dass die Musik Groove hat,
      auf der Bühne Spaß macht und zu unserem Sound mit Gitarren, Piano und
      Saxophon passt.
    </p>
    <p class="bb-prose body">
      Ob Stadtfest, Vereinsveranstaltung, Firmenfeier oder Musikabend: Wir
      freuen uns über Bühnen, auf denen ehrliche, handgemachte Livemusik gefragt
      ist.
    </p>
    <p class="lineup">{lineup}</p>
  </div>

  <div class="portrait">
    <Image
      src={portraitPhoto}
      alt="Die Bumblebees als Band"
      widths={[480, 800, 960, 1600]}
      sizes="(max-width: 860px) 92vw, 470px"
      loading="lazy"
    />
  </div>
</section>

<style>
  /*
   * The only section with padding on both sides — the shape and the collapse
   * to one column come from .bb-split, shared with the booking block.
   */
  .about {
    padding-block: var(--bb-section-y);
  }

  h2 {
    font-size: clamp(34px, 5.4vw, 52px);
    line-height: 0.98;
    margin-block: 18px 22px;
  }

  /* Size, leading and the paragraph gap come from .bb-prose. */
  .body {
    color: var(--bb-text);
    max-inline-size: 460px;
  }

  .lineup {
    font-family: var(--bb-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--bb-faint);
    text-transform: uppercase;
    margin-block-start: 36px;
    line-height: 1.8;
  }

  .portrait {
    height: 420px;
    border-radius: var(--bb-radius-lg);
    overflow: hidden;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Matches the breakpoint .bb-split collapses at. */
  @media (max-width: 860px) {
    .portrait {
      height: 320px;
    }
  }
</style>
