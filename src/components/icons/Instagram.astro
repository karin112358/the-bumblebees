---
/*
 * Inline SVG rather than an icon font or a CDN sprite: anything fetched from a
 * third party would hand every visitor's IP to that host on page load, which is
 * exactly what self-hosting the fonts removed.
 *
 * Purely decorative here — the accessible name belongs on the surrounding link,
 * so this is hidden from assistive tech and kept out of the tab order. `fill`
 * follows currentColor so the caller's colour and hover rules apply unchanged.
 */
interface Props {
  size?: number;
}

const { size = 17 } = Astro.props;
