---
/*
 * See Instagram.astro for why this is inline and hidden from assistive tech.
 *
 * The default size is larger than Instagram's on purpose: the YouTube mark is
 * drawn wide and short, so matching the two nominally would leave it looking
 * smaller than the Instagram square next to it.
 */
interface Props {
  size?: number;
}

const { size = 19 } = Astro.props;
---

