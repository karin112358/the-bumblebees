---
// TODO: confirm this mailbox actually exists. The local part is unchanged from
// the handoff; only the domain was corrected to the real one (.at, not .band).
// Mirrored in src/pages/impressum.astro — keep the two in step.
const email = 'booking@thebumblebees.at';
const instagram = 'https://www.instagram.com/bumblebeestheband';
---

<section class="booking" id="buchen">
  <span class="watermark" aria-hidden="true">Book</span>

  <div class="inner">
    <p class="eyebrow">Band buchen</p>
    <h2>Holt euch die Bumblebees auf eure Bühne.</h2>
    <p class="body">
      Ihr plant ein Fest, eine Firmenveranstaltung, einen Musikabend oder ein
      anderes Event, bei dem handgemachte Rockmusik nicht fehlen darf?
    </p>
    <p class="body">
      Wir bieten rund zwei Stunden Rock, Funk, Soul und Pop, auf Wunsch
      aufgeteilt auf mehrere Sets. Schreibt uns, wann und wo eure Veranstaltung
      stattfindet, wie groß sie ungefähr ist und welche Spielzeit ihr euch
      vorstellt. Wir melden uns mit den wichtigsten Informationen zu
      Verfügbarkeit, Technik und Konditionen.
    </p>

    <div class="actions">
      <a class="btn solid" href={`mailto:${email}`}>{email}</a>
      <a class="btn outline" href={instagram} target="_blank" rel="noopener"
        >@bumblebeestheband</a
      >
    </div>

    <p class="body">
      Einen aktuellen Eindruck von unseren Auftritten findet ihr auch auf
      Instagram: <a href={instagram} target="_blank" rel="noopener"
        >@bumblebeestheband</a
      >
    </p>
  </div>
</section>

<style>
  .booking {
    position: relative;
    background: var(--bb-amber);
    overflow: hidden;
    padding: var(--bb-section-y) 0;
  }

  .inner {
    position: relative;
    max-inline-size: var(--bb-max);
    margin-inline: auto;
    padding-inline: var(--bb-gutter);
  }

  .watermark {
    position: absolute;
    right: -40px;
    bottom: -60px;
    font-family: var(--bb-display);
    font-size: clamp(120px, 22vw, 220px);
    color: rgba(11, 11, 13, 0.06);
    line-height: 0.8;
    text-transform: uppercase;
    pointer-events: none;
  }

  /* Inverted against the amber panel, so not the shared .bb-eyebrow. */
  .eyebrow {
    font-family: var(--bb-mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--bb-panel);
    text-transform: uppercase;
    margin-block-end: 16px;
  }

  h2 {
    font-size: clamp(36px, 6.4vw, 60px);
    line-height: 0.94;
    color: var(--bb-panel);
    max-inline-size: 640px;
  }

  /*
   * .body is styled in About.astro, but Astro scopes component styles, so none
   * of that reaches here — these paragraphs were rendering with the inherited
   * grey --bb-text on amber and no margins at all (the global reset zeroes them).
   *
   * Narrower than the h2's 640px: at 16px this is roughly 70 characters, while
   * the full container width was running to about 130.
   */
  .body {
    font-size: 16px;
    line-height: 1.75;
    color: var(--bb-panel);
    max-inline-size: 560px;
    margin-block-start: 22px;
  }

  .body + .body {
    margin-block-start: 1.1em;
  }

  .actions + .body {
    margin-block-start: 28px;
  }

  /*
   * Without this the global `a { color: var(--bb-amber) }` paints the link the
   * exact colour of the panel behind it. Colour alone no longer distinguishes it
   * from the surrounding text either, so it carries an underline.
   */
  .body a {
    color: var(--bb-panel);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .body a:hover {
    color: var(--bb-panel);
    text-decoration-thickness: 2px;
  }

  .actions {
    display: flex;
    gap: 14px;
    margin-block-start: 34px;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--bb-condensed);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 16px;
    padding: 16px 30px;
    border-radius: var(--bb-radius-btn);
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
    /* The address is long enough to overflow a phone otherwise. */
    overflow-wrap: anywhere;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .solid {
    background: var(--bb-panel);
    color: var(--bb-amber);
  }

  .solid:hover {
    color: var(--bb-amber-hover);
  }

  .outline {
    border: 2px solid var(--bb-panel);
    color: var(--bb-panel);
  }

  .outline:hover {
    color: var(--bb-panel);
    opacity: 0.75;
  }

  .booking :focus-visible {
    outline-color: var(--bb-panel);
  }
</style>
