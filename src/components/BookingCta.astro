---
import InstagramIcon from './icons/Instagram.astro';

import { instagramUrl, handle } from '../data/social';

// TODO: confirm this mailbox actually exists. The local part is unchanged from
// the handoff; only the domain was corrected to the real one (.at, not .band).
// Mirrored in src/pages/impressum.astro — keep the two in step.
const email = 'booking@thebumblebees.at';
---

<section class="booking" id="buchen">
  <div class="inner">
    <div class="pitch">
      <p class="eyebrow">Band buchen</p>
      <h2>Holt euch die Bumblebees auf eure Bühne.</h2>
      <p class="body">
        Ihr plant ein Fest, eine Firmenveranstaltung, einen Musikabend oder ein
        anderes Event, bei dem handgemachte Rockmusik nicht fehlen darf?
      </p>
      {/*
        The "tell us date, size and playing time" half of this paragraph now
        lives in the card as a list — saying it in both places is what made the
        old block feel repetitive.
      */}
      <p class="body">
        Wir bieten rund zwei Stunden Rock, Funk, Soul und Pop, auf Wunsch
        aufgeteilt auf mehrere Sets. Wir melden uns mit den wichtigsten
        Informationen zu Verfügbarkeit, Technik und Konditionen.
      </p>
    </div>

    {/*
      One action, not two. The old layout put the e-mail button and an Instagram
      button side by side as if they were equivalent — one is the actual enquiry,
      the other a detour. Instagram is now a quiet line at the foot of the card,
      and it appears once instead of twice.
    */}
    <div class="card">
      <h3>Anfrage</h3>

      <a class="btn" href={`mailto:${email}`}>{email}</a>

      <p class="hint">Damit wir schnell antworten können, schreibt uns dazu:</p>
      <ul class="checklist">
        <li>Datum und Ort</li>
        <li>Ungefähre Größe der Veranstaltung</li>
        <li>Gewünschte Spielzeit</li>
      </ul>

      {/*
        The visible text carries the whole accessible name on purpose — an
        aria-label naming Instagram while the link reads "@bumblebeestheband"
        would break WCAG 2.5.3 (Label in Name).
      */}
      <p class="social">
        <a href={instagramUrl} target="_blank" rel="noopener">
          <InstagramIcon size={16} />
          <span>{handle} auf Instagram</span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  /*
   * No `position: relative` or `overflow: hidden` here any more: both existed
   * only to anchor and clip the "Booking" watermark, which is gone. Nothing in
   * the section bleeds past its edges now.
   */
  .booking {
    background: var(--bb-amber);
    padding: var(--bb-section-y) 0;
  }

  /*
   * Same two-column shape as About.astro — one grid pattern for the page rather
   * than a second one just for this block.
   */
  .inner {
    max-inline-size: var(--bb-max);
    margin-inline: auto;
    padding-inline: var(--bb-gutter);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }

  /* Inverted against the amber panel, so not the shared .bb-eyebrow. */
  .eyebrow {
    font-family: var(--bb-mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--bb-panel);
    text-transform: uppercase;
    margin-block-end: 16px;
  }

  /*
   * 1.02 rather than the 0.94 this used to carry. At 0.94 the umlaut dots of
   * "BÜHNE" collided with the line above — uppercase diacritics sit higher than
   * the cap height, and German headings here will always have some. The look is
   * still tight, just not broken.
   */
  h2 {
    font-size: clamp(36px, 6.4vw, 60px);
    line-height: 1.02;
    color: var(--bb-panel);
    max-inline-size: 640px;
  }

  /*
   * .body is styled in About.astro, but Astro scopes component styles, so none
   * of that reaches here — these paragraphs were rendering with the inherited
   * grey --bb-text on amber and no margins at all (the global reset zeroes them).
   *
   * Narrower than the h2's 640px: at 16px this is roughly 70 characters, while
   * the full container width was running to about 130.
   */
  .body {
    font-size: 16px;
    line-height: 1.75;
    color: var(--bb-panel);
    max-inline-size: 560px;
    margin-block-start: 22px;
  }

  .body + .body {
    margin-block-start: 1.1em;
  }

  .card {
    background: var(--bb-panel);
    border-radius: var(--bb-radius-lg);
    padding: clamp(24px, 3.5vw, 40px);
  }

  /* A mono label, not the global Anton caps — h3 is for the heading order. */
  .card h3 {
    font-family: var(--bb-mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--bb-amber);
    line-height: 1;
  }

  /*
   * Inverted against the button on the amber panel: there it is a dark block on
   * yellow, here a yellow block on dark. Same relationship as the confirm button
   * in VideoSection's consent notice.
   */
  .btn {
    display: block;
    text-align: center;
    margin-block-start: 22px;
    font-family: var(--bb-condensed);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 16px;
    padding: 16px 20px;
    border-radius: var(--bb-radius-btn);
    background: var(--bb-amber);
    color: var(--bb-panel);
    /* The address is long enough to overflow a phone otherwise. */
    overflow-wrap: anywhere;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  /* Needs its own colour: the global a:hover would repaint the label amber. */
  .btn:hover {
    background: var(--bb-amber-hover);
    color: var(--bb-panel);
    transform: translateY(-2px);
  }

  .hint {
    margin-block-start: 26px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--bb-muted);
  }

  .checklist {
    margin-block-start: 14px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .checklist li {
    position: relative;
    padding-inline-start: 18px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--bb-white);
  }

  /* An amber dot rather than a list marker, to match the section's accents. */
  .checklist li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.72em;
    inset-inline-start: 0;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--bb-amber);
    transform: translateY(-50%);
  }

  .social {
    margin-block-start: 28px;
    padding-block-start: 20px;
    border-block-start: 1px solid var(--bb-border);
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--bb-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--bb-muted);
  }

  .social a:hover {
    color: var(--bb-amber);
  }

  .booking :focus-visible {
    outline-color: var(--bb-panel);
  }

  /*
   * Must follow the rule above — same specificity, so source order decides.
   * Inside the dark card a panel-coloured ring is invisible, and that is exactly
   * where the only action of the section sits.
   */
  .card :focus-visible {
    outline-color: var(--bb-amber);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
