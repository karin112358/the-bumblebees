---
/*
 * The black bee, not the amber one — this strip is amber. ?url rather than an
 * SVG-component import matters here: the mark repeats once per copy, so
 * inlining ~57 KB of path data would land in the HTML ten times over. As a URL
 * it is one cached file no matter how many copies reference it.
 */
import beeBlackUrl from '../assets/logo/bee-black.svg?url';

import { getShows, formatShowDate } from '../lib/shows';

/*
 * The strip says something the hero doesn't: the styles, and the next gig
 * straight from shows.yaml. Like the show list, the date is frozen at build
 * time and moves on with the next rebuild. Without an upcoming (non-cancelled)
 * show it falls back to a plain "Live".
 */
const { upcoming } = await getShows();
const next = upcoming.find((show) => !show.data.cancelled);

// The town is the text after the postcode in "…, 4532 Rohr im Kremstal".
const town = next?.data.city.split(',').at(-1)?.trim().replace(/^\d{4}\s+/, '');
const date = next && formatShowDate(next.data.date);

const styles = ['Rock', 'Funk', 'Soul', 'Pop'];
const phrase = [...styles, date ? `Nächstes Konzert ${date.day}. ${date.month} – ${town}` : 'Live'].join(
  ' ✦ ',
);
// Spelled out for screen readers: "21. November", not the visual "21. NOV".
const spoken = [...styles, date ? `Nächstes Konzert am ${date.spoken} in ${town}` : 'Live'].join('. ');

/*
 * The animation runs one copy per cycle, so a fixed duration would make the
 * speed follow the phrase length, which now changes with shows.yaml (a long
 * town, or the short "Live" fallback). Scaling by character count keeps it at
 * roughly the original ~46px/s. 0.3s per character is measured, not derived.
 */
const SECONDS_PER_CHAR = 0.3;
const duration = `${(phrase.length * SECONDS_PER_CHAR).toFixed(1)}s`;

/*
 * The strip loops by shifting left exactly one copy, then snapping back — so
 * the remaining COPIES - 1 copies have to be wide enough to cover the viewport
 * on their own. Otherwise a blank wedge sweeps through on every cycle, which is
 * invisible on a phone and obvious on a desktop.
 *
 * One copy renders well over 510px at the maximum font size, so 9 spare
 * copies cover more than 4590px — comfortably past any real browser window.
 * The extra markup is a few hundred bytes.
 */
const COPIES = 10;
---

<div class="marquee">
  <div class="track" aria-hidden="true" style={`--copies:${COPIES}; --duration:${duration}`}>
    {Array.from({ length: COPIES }, () => <span>{phrase}</span>)}
  </div>
  <span class="sr-only">{spoken}.</span>
</div>

<style>
  .marquee {
    background: var(--bb-amber);
    overflow: hidden;
    padding: 12px 0;
  }

  .track {
    display: flex;
    width: max-content;
    /*
     * Duration is time-per-copy, not time-per-loop, so the scroll speed stays
     * constant if COPIES ever changes. --duration comes from the phrase length
     * in the frontmatter.
     */
    animation: bb-marquee var(--duration) linear infinite;
    font-family: var(--bb-display);
    font-size: clamp(20px, 3vw, 26px);
    letter-spacing: 0.06em;
    color: var(--bb-panel);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .track span {
    padding: 0 44px;
    /* Copies must stay equal width for the shift to land seamlessly. */
    flex: none;
    /* inline-flex so the bee sits on the text's optical centre rather than the
       baseline, where it would hang below the caps. */
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
  }

  /*
   * Sized in em so it tracks the clamped font size. 1.25em keeps it inside the
   * existing line box, so adding it does not change the strip's height.
   */
  .track img {
    height: 1.25em;
    width: auto;
  }

  @keyframes bb-marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* A translateX percentage resolves against the track's own width, so
         dividing by the copy count shifts by exactly one copy. */
      transform: translateX(calc(-100% / var(--copies)));
    }
  }

  /*
   * The global reduced-motion rule collapses animation duration, which would
   * freeze the track mid-slide. Reset the transform so it parks at the start.
   */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      transform: none;
    }
  }
</style>
