---
import { Image } from 'astro:assets';

import band2 from '../assets/images/band-2.jpg';
import band3 from '../assets/images/band-3.jpg';
import band4 from '../assets/images/band-4.jpg';
import band5 from '../assets/images/band-5.jpg';
import bandWide from '../assets/images/band-3.jpeg';

/*
 * Five tiles on a three-column grid. Tile 1 is double-height and tile 5 is
 * double-width, which is what gives the block its rhythm.
 *
 * band-3.jpeg is the panoramic one (2016x1134) so it takes the wide slot;
 * band-1.jpg is spoken for by the hero.
 */
const tiles = [
  { src: band2, alt: 'Die Bumblebees auf der Bühne', span: 'tall' },
  { src: band3, alt: 'Die Bumblebees beim Konzert' },
  { src: band4, alt: 'Die Bumblebees live' },
  { src: band5, alt: 'Die Bumblebees im Auftritt' },
  { src: bandWide, alt: 'Die Bumblebees in voller Besetzung', span: 'wide' },
];
---

<section class="bb-section" id="medien">
  <div class="bb-section-head">
    <h2>Galerie</h2>
    <p class="bb-eyebrow">Fotos</p>
  </div>

  <ul class="grid">
    {
      tiles.map(({ src, alt, span }) => (
        <li class={span}>
          <Image
            src={src}
            alt={alt}
            widths={[400, 800, 1200]}
            sizes="(max-width: 720px) 100vw, 33vw"
            loading="lazy"
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 200px;
    gap: 14px;
  }

  .grid li {
    position: relative;
    border-radius: var(--bb-radius);
    overflow: hidden;
    background: var(--bb-stripes);
  }

  .grid :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .grid li:hover :global(img) {
    transform: scale(1.04);
  }

  .tall {
    grid-row: span 2;
  }

  .wide {
    grid-column: span 2;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 150px;
    }

    /* The span tricks stop reading as rhythm once there are only two columns. */
    .tall {
      grid-row: auto;
    }

    .wide {
      grid-column: span 2;
    }
  }
</style>
