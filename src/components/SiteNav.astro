---
/*
 * bee.svg is ~57 KB of traced path data. Inlining it as an SVG component would
 * push all of that into the HTML on every load, so it is imported with Vite's
 * ?url suffix and served as a separately cacheable file instead.
 */
import beeUrl from '../assets/logo/bee.svg?url';

/*
 * ?url here too, rather than the SVG-component import: Hero.astro already
 * inlines wordmark.svg, and inlining it a second time would duplicate the whole
 * path set in the HTML. As a URL both places share one cached file.
 */
import wordmarkUrl from '../assets/logo/wordmark.svg?url';

/*
 * Every section these point at lives on the start page, so the fragments are
 * anchored to it rather than left bare. A bare "#konzerte" resolves against
 * whatever document is showing — on /impressum/ that means scrolling nowhere.
 *
 * On the start page itself the path is identical to the current URL, so these
 * stay same-document fragment navigations: no reload, and the smooth scrolling
 * from BaseLayout still applies.
 */
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

const links = [
  { hash: '#ueber-uns', label: 'Über uns' },
  { hash: '#medien', label: 'Galerie' },
  { hash: '#video', label: 'Video' },
  { hash: '#konzerte', label: 'Konzerte' },
  { hash: '#buchen', label: 'Buchen' },
/*
 * `id` rides along beside the finished href: the scroll spy has to find each
 * link's section, and the rendered href is base-prefixed, so a lookup by
 * href alone would have to parse the URL back apart. Derived here so the list
 * above stays the single place a section is named.
 */
].map(({ hash, label }) => ({ href: `${home}${hash}`, id: hash.slice(1), label }));

/*
 * The design highlights one link as the current section, which only means
 * anything while the start page's sections are actually on screen. On a
 * standalone page like /impressum/ it would falsely mark "Über uns" as where
 * the reader is. Trailing slashes are stripped on both sides because `base`
 * may be written with or without one.
 */
const strip = (path: string) => path.replace(/\/$/, '');
const onHome = strip(Astro.url.pathname) === strip(home);
---

{
  /* Watched by the observer below: once it scrolls out, the nav has lifted off. */
}
<div class="sentinel" aria-hidden="true"></div>

<header class:list={['nav', { 'is-home': onHome }]}>
  {/* The bar spans the viewport; only its contents are held to the column. */}
  <div class="nav-inner bb-container">
    <a class="brand" href={`${home}#top`}>
      {
        /* Intrinsic sizes match each viewBox ratio, so the row reserves the right
          box and nothing shifts as the two files load. The bee is decorative;
          the wordmark's alt supplies the link's accessible name. */
      }
      <img class="mark" src={beeUrl} alt="" width="37" height="36" />
      <img
        class="wordmark"
        src={wordmarkUrl}
        alt="The Bumblebees"
        width="124"
        height="32"
      />
    </a>

    <button
      class="toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span class="sr-only">Menü öffnen</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav id="nav-links" class="links" aria-label="Hauptnavigation">
      {
        links.map(({ href, id, label }) => (
          <a href={href} data-section={id}>
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const header = document.querySelector<HTMLElement>('.nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.querySelector('.sr-only')!.textContent = open
      ? 'Menü öffnen'
      : 'Menü schließen';
    header?.classList.toggle('is-open', !open);
  });

  // Tapping a link on mobile should dismiss the drawer, not leave it covering
  // the section it just scrolled to.
  header?.querySelectorAll('.links a').forEach((link) =>
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      header.classList.remove('is-open');
    }),
  );

  /*
   * The nav only takes a background once it detaches from the top. An observer
   * on a 1px sentinel beats a scroll listener: it fires when the state actually
   * changes rather than on every frame of every scroll.
   */
  const sentinel = document.querySelector('.sentinel');

  if (sentinel && header) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-stuck', !entry.isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);
  }

  /*
   * Which link is the current one. Only on the start page — elsewhere the
   * sections do not exist and nothing should be marked (see .is-home).
   *
   * Deliberately a scroll listener rather than another IntersectionObserver
   * like the one above: the sentinel is a single binary state that flips
   * rarely, while the active section is decided by five boundaries crossing
   * one line. An observer would need a rootMargin collapsing the viewport to
   * that line — a value that depends on the viewport height and has to be
   * rebuilt on every resize, for no less work than the five rect reads below.
   */
  if (header?.classList.contains('is-home')) {
    const targets: { link: HTMLAnchorElement; section: HTMLElement }[] = [];

    header
      .querySelectorAll<HTMLAnchorElement>('.links a[data-section]')
      .forEach((link) => {
        const section = document.getElementById(link.dataset.section!);
        if (section) targets.push({ link, section });
      });

    if (targets.length) {
      /*
       * The same offset scroll-padding-top uses in BaseLayout, read from the
       * token rather than repeated: the line the sections are measured against
       * then sits exactly where an anchor jump parks them.
       */
      const root = getComputedStyle(document.documentElement);
      const navH = parseFloat(root.getPropertyValue('--bb-nav-h')) || 80;

      let current: HTMLAnchorElement | null = null;

      const update = () => {
        const max = document.documentElement.scrollHeight - innerHeight;

        // The scroll position at which each section's top slides under the bar.
        const points = targets.map(
          ({ section }) => section.getBoundingClientRect().top + scrollY - navH,
        );

        /*
         * Whatever sits in the last viewport-height of the document can never
         * bring its top up to that line — the page runs out of scrolling first.
         * On a tall window that is Konzerte and Buchen, which would then never
         * be marked at all, not even by clicking them. So the points past the
         * end get spread over the scrolling that is actually left, in order,
         * and the final stretch still walks through them one by one.
         */
        const stuck = points.findIndex((point) => point > max);

        if (stuck !== -1 && max > 0) {
          const from = stuck === 0 ? 0 : points[stuck - 1];
          const share = (max - from) / (points.length - stuck);

          for (let i = stuck; i < points.length; i++) {
            points[i] = from + share * (i - stuck + 1);
          }
        }

        /*
         * The last section that has been reached — none of them over the hero,
         * where the reader is not in a section yet and nothing is marked.
         * Sections without a link of their own (#setlist, #band) are not
         * candidates, so they leave the preceding one marked rather than
         * blanking the highlight halfway down the page.
         */
        let active: HTMLAnchorElement | null = null;

        for (let i = 0; i < points.length; i++) {
          if (scrollY >= points[i] - 1) active = targets[i].link;
        }

        if (active === current) return;

        current?.removeAttribute('aria-current');
        active?.setAttribute('aria-current', 'true');
        current = active;
      };

      let queued = false;

      const schedule = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      };

      addEventListener('scroll', schedule, { passive: true });
      // Section tops move when the column reflows, not only when the page
      // scrolls — a rotation or a late-loading gallery image shifts them all.
      addEventListener('resize', schedule, { passive: true });

      /*
       * Run straight away rather than waiting for the first scroll: the page
       * may already be mid-document from a #fragment or a restored scroll
       * position, and the right link has to be lit before the reader looks.
       */
      update();
    }
  }
</script>

<style>
  .sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 1px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    /* Transparent over the hero photo; .is-stuck fills it in once it detaches. */
    background: transparent;
    border-block-end: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  /*
   * .bb-container supplies the column cap and the centring; the padding is the
   * one thing the bar does differently — a slightly tighter gutter than
   * --bb-gutter, plus the 22px band that makes up --bb-nav-h.
   */
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px clamp(20px, 3.4vw, 40px);
  }

  .nav.is-stuck,
  /* An open drawer needs the bar opaque even at the very top of the page. */
  .nav.is-open {
    background: color-mix(in srgb, var(--bb-panel) 92%, transparent);
    border-block-end-color: var(--bb-border);
    backdrop-filter: blur(10px);
  }

  /* Two images now, so none of the old type properties apply here any more. */
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand img {
    width: auto;
  }

  .mark {
    height: 36px;
  }

  /*
   * The wordmark face is much more condensed than the Anton text it replaces,
   * so it is sized to match the old lockup width (~126px) rather than the old
   * cap height, which would have looked undersized. Kept below the bee's 36px:
   * the brand row must not grow, because --bb-nav-h is a fixed 80px that
   * scroll-padding-top and the hero's negative margin both depend on.
   */
  .wordmark {
    height: 32px;
  }

  /*
   * Only the wordmark shrinks on narrow screens. The bee governs the row
   * height, so shrinking it too would drop the nav below --bb-nav-h and pull
   * the hero's negative margin out of alignment.
   */
  @media (max-width: 420px) {
    .wordmark {
      height: 26px;
    }
  }

  .links {
    display: flex;
    gap: 30px;
    font-family: var(--bb-condensed);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    font-size: 14px;
  }

  .links a {
    color: var(--bb-nav);
  }

  /* The section currently under the bar, marked by the spy in the script
     above. Start page only — see the frontmatter note on .is-home. No fallback
     for a page without JavaScript: nothing is marked at the top of the
     document either, so an unmarked bar is the honest resting state. */
  .nav.is-home .links a[aria-current='true'] {
    color: var(--bb-amber);
  }

  .links a:hover {
    color: var(--bb-amber-hover);
  }

  .toggle {
    display: none;
    background: none;
    border: 0;
    padding: 10px;
    cursor: pointer;
  }

  /* Three lines that fold into an X, drawn from one element plus its pseudos. */
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--bb-white);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: relative;
  }

  .bars::before {
    top: -7px;
  }

  .bars::after {
    top: 5px;
  }

  @media (max-width: 760px) {
    .toggle {
      display: block;
    }

    .links {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--bb-panel);
      border-block: 1px solid var(--bb-border);
      /* Collapsed by default; the toggle swaps in the open state below. */
      display: none;
    }

    .nav.is-open .links {
      display: flex;
    }

    .links a {
      padding: 16px clamp(20px, 3.4vw, 40px);
      font-size: 16px;
    }

    .links a + a {
      border-block-start: 1px solid var(--bb-border);
    }

    .nav.is-open .bars {
      transform: rotate(45deg);
    }

    .nav.is-open .bars::before {
      opacity: 0;
    }

    .nav.is-open .bars::after {
      top: -2px;
      transform: rotate(-90deg);
    }
  }
</style>
