---
import { getShows, formatShowDate, isoDate } from '../lib/shows';

const { upcoming } = await getShows();
---

<section class="bb-section" id="konzerte">
  <div class="bb-section-head">
    <h2>Kommende Konzerte</h2>
    <p class="bb-eyebrow">Live</p>
  </div>

  {
    upcoming.length === 0 ? (
      <p class="empty">
        Aktuell sind keine Konzerte angekündigt. Termine folgen — schaut bald
        wieder vorbei.
      </p>
    ) : (
      <ol class="list">
        {upcoming.map((show, i) => {
          const { weekday, day, month } = formatShowDate(show.data.date);
          const time = show.data.time;
          const tag = show.data.soldOut ? 'Ausverkauft' : show.data.note;

          return (
            /* The next gig up gets the amber edge; the rest stay muted. */
            <li class:list={['row', { next: i === 0 }]}>
              <time class="date" datetime={isoDate(show.data.date)}>
                {weekday} {day}
                <span>{month}</span>
              </time>

              <div>
                <p class="venue">{show.data.venue}</p>
                <p class="place">
                  {show.data.city}
                  {show.data.country && `, ${show.data.country}`}
                </p>
                {(time || show.data.infoUrl) && (
                  <p class="meta">
                    {time && <span class="time">Beginn {time} Uhr</span>}
                    {time && show.data.infoUrl && (
                      <span class="sep" aria-hidden="true">
                        •
                      </span>
                    )}
                    {show.data.infoUrl && (
                      <a
                        class="info"
                        href={show.data.infoUrl}
                        target="_blank"
                        rel="noopener"
                      >
                        Mehr Infos<span class="arrow" aria-hidden="true">→</span>
                      </a>
                    )}
                  </p>
                )}
              </div>

              {show.data.ticketUrl && !show.data.soldOut ? (
                <a class="tag link" href={show.data.ticketUrl}>
                  Tickets
                </a>
              ) : (
                tag && (
                  <span class:list={['tag', { out: show.data.soldOut }]}>
                    {tag}
                  </span>
                )
              )}
            </li>
          );
        })}
      </ol>
    )
  }
</section>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .row {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 22px 20px;
    background: var(--bb-card);
    border-inline-start: 3px solid var(--bb-border-row);
  }

  .next {
    border-inline-start-color: var(--bb-amber);
  }

  .date {
    font-family: var(--bb-display);
    font-size: 22px;
    color: var(--bb-amber);
    line-height: 1.1;
  }

  .date span {
    display: block;
    font-size: 13px;
    color: var(--bb-faint);
  }

  .venue {
    font-family: var(--bb-condensed);
    font-weight: 700;
    font-size: 22px;
    color: var(--bb-white);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.2;
  }

  .place {
    font-size: 13px;
    color: var(--bb-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-block-start: 4px;
  }

  .time {
    font-family: var(--bb-condensed);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--bb-amber);
  }

  .sep {
    color: var(--bb-dim);
    font-size: 9px;
  }

  .info {
    font-family: var(--bb-condensed);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bb-nav);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.15s ease;
  }

  .info:hover {
    color: var(--bb-amber);
  }

  /* inline-block keeps the parent's underline from being drawn through it. */
  .info .arrow {
    display: inline-block;
    margin-inline-start: 8px;
    transition: translate 0.15s ease;
  }

  .info:hover .arrow {
    translate: 3px 0;
  }

  .tag {
    font-family: var(--bb-condensed);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 14px;
    color: var(--bb-amber);
    border: 1.5px solid var(--bb-border-tag);
    padding: 10px 18px;
    border-radius: var(--bb-radius-btn);
    white-space: nowrap;
  }

  .link:hover {
    border-color: var(--bb-amber);
  }

  .out {
    color: var(--bb-faint);
  }

  .empty {
    color: var(--bb-muted);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .date {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .tag {
      justify-self: start;
    }
  }
</style>
