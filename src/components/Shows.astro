---
import { getShows, formatShowDate, isoDate } from '../lib/shows';

const { upcoming, past } = await getShows();

/*
 * Played gigs stay on the page as a short archive: it shows bookers the band
 * is active, and every venue and town in it is text search engines can match
 * local queries against. Cancelled shows are dropped — the band wasn't there.
 * Capped to the most recent few, so the list doesn't push the booking section
 * further down with every season. `past` is already sorted newest first.
 */
const PAST_LIMIT = 6;
const played = past.filter((show) => !show.data.cancelled).slice(0, PAST_LIMIT);
---

<section class="bb-section" id="konzerte">
  <div class="bb-section-head">
    <h2>Kommende Konzerte</h2>
    <p class="bb-eyebrow">Live</p>
  </div>

  {
    upcoming.length === 0 ? (
      <p class="empty">
        Aktuell sind keine Konzerte angekündigt. Termine folgen — schaut bald
        wieder vorbei.
      </p>
    ) : (
      <ol class="list">
        {upcoming.map((show, i) => {
          const { weekday, day, month } = formatShowDate(show.data.date);
          const time = show.data.time;
          const tag = show.data.soldOut ? 'Ausverkauft' : show.data.note;

          return (
            /* The next gig up gets the amber edge; the rest stay muted. */
            <li class:list={['row', { next: i === 0 }]}>
              <time class="date" datetime={isoDate(show.data.date)}>
                {weekday} {day}
                <span>{month}</span>
              </time>

              <div>
                <p class="venue">{show.data.venue}</p>
                <p class="place">
                  {show.data.city}
                  {show.data.country && `, ${show.data.country}`}
                </p>
                {(time || show.data.infoUrl) && (
                  <p class="meta">
                    {time && <span class="time">Beginn {time} Uhr</span>}
                    {time && show.data.infoUrl && (
                      <span class="sep" aria-hidden="true">
                        •
                      </span>
                    )}
                    {show.data.infoUrl && (
                      <a
                        class="info"
                        href={show.data.infoUrl}
                        target="_blank"
                        rel="noopener"
                      >
                        Mehr Infos<span class="arrow" aria-hidden="true">→</span>
                      </a>
                    )}
                  </p>
                )}
              </div>

              {show.data.ticketUrl && !show.data.soldOut ? (
                <a class="tag link" href={show.data.ticketUrl}>
                  Tickets
                </a>
              ) : (
                tag && (
                  <span class:list={['tag', { out: show.data.soldOut }]}>
                    {tag}
                  </span>
                )
              )}

              {show.data.notice && (
                <div class="notice">
                  <span class="notice-icon" aria-hidden="true">!</span>
                  <div>
                    <p class="notice-title">Wichtiger Hinweis</p>
                    <p class="notice-text">{show.data.notice}</p>
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ol>
    )
  }

  {
    played.length > 0 && (
      <div class="past">
        <h3 class="past-title">Zuletzt gespielt</h3>
        <ul class="past-list">
          {played.map((show) => (
            <li>
              <time datetime={isoDate(show.data.date)}>
                {formatShowDate(show.data.date).numeric}
              </time>
              <span class="past-venue">{show.data.venue}</span>
              <span class="past-place">{show.data.city}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .row {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 22px 20px;
    background: var(--bb-card);
    border-inline-start: 3px solid var(--bb-border-row);
  }

  .next {
    border-inline-start-color: var(--bb-amber);
  }

  .date {
    font-family: var(--bb-display);
    font-size: 22px;
    color: var(--bb-amber);
    line-height: 1.1;
  }

  .date span {
    display: block;
    font-size: 13px;
    /* muted, not faint: faint is only 3.5:1 on the card behind it. */
    color: var(--bb-muted);
  }

  .venue {
    font-family: var(--bb-condensed);
    font-weight: 700;
    font-size: 22px;
    color: var(--bb-white);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.2;
  }

  .place {
    font-size: 13px;
    color: var(--bb-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-block-start: 4px;
  }

  .time {
    font-family: var(--bb-condensed);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--bb-amber);
  }

  .sep {
    color: var(--bb-dim);
    font-size: 9px;
  }

  .info {
    font-family: var(--bb-condensed);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bb-nav);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.15s ease;
  }

  .info:hover {
    color: var(--bb-amber);
  }

  /* inline-block keeps the parent's underline from being drawn through it. */
  .info .arrow {
    display: inline-block;
    margin-inline-start: 8px;
    transition: translate 0.15s ease;
  }

  .info:hover .arrow {
    translate: 3px 0;
  }

  .tag {
    font-family: var(--bb-condensed);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 14px;
    color: var(--bb-amber);
    border: 1.5px solid var(--bb-border-tag);
    padding: 10px 18px;
    border-radius: var(--bb-radius-btn);
    white-space: nowrap;
  }

  .link:hover {
    border-color: var(--bb-amber);
  }

  .out {
    color: var(--bb-faint);
  }

  .notice {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 18px;
    margin-block-start: 6px;
    padding: 16px 20px;
    background: var(--bb-amber);
    color: var(--bb-black);
  }

  .notice-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 2px solid var(--bb-black);
    border-radius: 50%;
    font-family: var(--bb-display);
    font-size: 18px;
    line-height: 1;
  }

  .notice-title {
    font-family: var(--bb-condensed);
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .notice-text {
    margin-block-start: 2px;
    font-size: 15px;
    font-weight: 600;
  }

  .empty {
    color: var(--bb-muted);
  }

  /* Deliberately quieter than the upcoming rows: a record, not a call to action. */
  .past {
    margin-block-start: 40px;
  }

  .past-title {
    font-family: var(--bb-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bb-muted);
    margin-block-end: 12px;
  }

  .past-list li {
    display: grid;
    /* Fixed venue column: each li is its own grid, so `auto` would misalign the rows. */
    grid-template-columns: 120px 240px 1fr;
    align-items: baseline;
    gap: 24px;
    padding: 12px 20px;
    border-block-start: 1px solid var(--bb-border-row);
    font-size: 14px;
    color: var(--bb-muted);
  }

  .past-list time {
    font-family: var(--bb-mono);
    font-size: 13px;
    color: var(--bb-muted);
  }

  .past-venue {
    font-family: var(--bb-condensed);
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--bb-text);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .date {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .tag {
      justify-self: start;
    }

    .past-list li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
