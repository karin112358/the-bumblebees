---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Mirrors BookingCta — keep the two in step.
// TODO: confirm this mailbox actually exists. The local part is unchanged from
// the handoff; only the domain was corrected to the real one (.at, not .band).
const email = 'booking@thebumblebees.at';
---

<BaseLayout
  title="Impressum"
  description="Impressum und Offenlegung der Hobbyband The Bumblebees."
>
  <SiteNav />

  <main class="legal bb-section">
    <p class="bb-eyebrow">Rechtliches</p>
    <h1>Impressum</h1>

    <section>
      <h2>Medieninhaber</h2>
      <p>
        Martin Stummer-Brandstätter<br />
        4501 Neuhofen an der Krems<br />
        Österreich
      </p>
      <p>
        E-Mail: <a href={`mailto:${email}`}>{email}</a>
      </p>
    </section>

    <section>
      <h2>Offenlegung gemäß § 25 MedienG</h2>
      <p>
        Diese Website dient der Präsentation der Hobbyband The Bumblebees, einer
        Band der Landesmusikschule Bad Hall, ihrer Mitglieder, Musik und
        Auftritte.
      </p>
    </section>

    <section>
      <h2>Urheberrecht</h2>
      <p>
        Die Inhalte dieser Website, insbesondere Texte, Fotos, Grafiken, Videos
        und Musik, sind urheberrechtlich geschützt. Eine Verwendung außerhalb
        der gesetzlichen Grenzen bedarf der Zustimmung der jeweiligen
        Rechteinhaber.
      </p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
